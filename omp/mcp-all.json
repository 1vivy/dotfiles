{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/obsidian-mcp",
      "enabled": true,
      "startupTimeoutMs": 90000,
      "requestTimeoutMs": 60000
    },
    "workstation-vault-notes": {
      "type": "http",
      "url": "https://cachyos-x8664.${TS_DNS_SUFFIX}:8470/servers/notes/mcp",
      "enabled": true,
      "startupTimeoutMs": 8000
    },
    "workstation-vault-settings": {
      "type": "http",
      "url": "https://cachyos-x8664.${TS_DNS_SUFFIX}:8470/servers/settings/mcp",
      "enabled": true,
      "startupTimeoutMs": 8000
    },
    "mac-vault-notes": {
      "type": "http",
      "url": "https://vivys-macbook-air.${TS_DNS_SUFFIX}:8470/servers/notes/mcp",
      "enabled": true,
      "startupTimeoutMs": 8000
    },
    "mac-vault-settings": {
      "type": "http",
      "url": "https://vivys-macbook-air.${TS_DNS_SUFFIX}:8470/servers/settings/mcp",
      "enabled": true,
      "startupTimeoutMs": 8000
    }
  }
}
