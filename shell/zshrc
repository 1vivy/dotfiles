# `omp update`: reconcile local prompt overrides with the deterministic updater.
# Exit 3 prints the review needed; it does not dispatch an archived skill or model session.
omp-reconcile() {
  local zshrc=~/.zshrc
  python3 "${zshrc:A:h:h}/omp/prompts/reconcile-omp.py" "$@"
}
omp() {
  if [[ $1 != update || " $* " == *" -c "* || " $* " == *" --check "* ]]; then
    command omp "$@"
    return
  fi
  local before after
  before=$(command omp --version 2>/dev/null)
  command omp "$@" || return
  after=$(command omp --version 2>/dev/null)
  [[ $before == "$after" ]] || { print "omp: $before -> $after, reconciling prompt overrides"; omp-reconcile; }
}

# Dotfiles freshness, oh-my-zsh reminder style: fetch origin in the background at most once a
# day, and report on shell start when this checkout is behind or ahead. `dotfiles-update`
# fast-forwards and re-runs install.sh with the profile it was last installed with.
_dotfiles_freshness() {
  local zshrc=~/.zshrc dir state stamp behind ahead
  local -a stale
  dir=${zshrc:A:h:h}
  [[ -d $dir/.git ]] || return
  state=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles
  stamp=$state/last-fetch
  stale=( $stamp(Nmh+23) )
  if [[ ! -e $stamp || -n $stale ]]; then
    mkdir -p $state && : >| $stamp
    ( GIT_TERMINAL_PROMPT=0 git -C $dir fetch -q origin >/dev/null 2>&1 & ) 2>/dev/null
  fi
  behind=$(git -C $dir rev-list --count HEAD..@{u} 2>/dev/null) || return
  ahead=$(git -C $dir rev-list --count @{u}..HEAD 2>/dev/null)
  (( behind )) && print -P "%F{yellow}dotfiles: $behind commit(s) behind origin; run dotfiles-update%f"
  (( ahead )) && print -P "%F{yellow}dotfiles: $ahead local commit(s) not pushed%f"
  return 0
}
_dotfiles_freshness
dotfiles-update() {
  local zshrc=~/.zshrc dir profile
  dir=${zshrc:A:h:h}
  local f=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/profile
  [[ -r $f ]] && profile=$(<$f)
  [[ -n $profile ]] || { print -u2 "dotfiles-update: no recorded profile; run install.sh --profile <name> once"; return 2; }
  git -C $dir fetch -q origin && git -C $dir merge --ff-only @{u} && $dir/install.sh --profile $profile
}

