# Gram never installs its SSH remote server. Install the matching release binary on a host
# before the first "Connect" from Gram: gram-remote-install [user@]host
gram-remote-install() {
  local host=${1:?usage: gram-remote-install [user@]host} ver os arch asset bin cache sha rsha
  ver=${${(z)"$(command gram --version)"}[2]%%-*} || return
  read -r os arch <<<"$(ssh "$host" uname -sm)" || return
  os=${os:l}; [[ $os == darwin ]] && os=macos; [[ $arch == arm64 ]] && arch=aarch64
  asset=gram-remote-server-$os-$arch-$ver.gz
  [[ $os == macos ]] && asset=gram-remote_server-$os-$arch-$ver.gz
  bin=gram-remote-server-stable-$ver
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/gram-remote-server/$os-$arch-$ver
  if [[ ! -s $cache ]]; then
    mkdir -p ${cache:h} &&
      curl -fL "https://codeberg.org/GramEditor/gram/releases/download/$ver/$asset" | gunzip >$cache.part &&
      mv $cache.part $cache || { rm -f $cache.part; return 1; }
  fi
  sha=$( (sha256sum || shasum -a 256) <$cache 2>/dev/null) && sha=${sha%% *}
  rsha=$(ssh "$host" "mkdir -p .gram_server && cat >.gram_server/$bin.part && chmod +x .gram_server/$bin.part &&
    mv .gram_server/$bin.part .gram_server/$bin && .gram_server/$bin version >&2 &&
    { sha256sum || shasum -a 256; } <.gram_server/$bin" <$cache) || return
  [[ ${rsha%% *} == $sha ]] || { print -u2 "gram-remote-install: $host checksum mismatch"; return 1; }
  print "gram-remote-install: $host ~/.gram_server/$bin ($sha)"
}

# SSH into the hermes-uni container as the hermes user
uni-ssh() { ssh -t atlas-apps2 "docker exec -it -u 10000:10000 hermes-uni ${@:-/bin/sh}"; }

# Add bun to path
export PATH="$HOME/.bun/bin:$PATH"

# Homebrew openjdk (keg-only on macOS)
[[ -d /opt/homebrew/opt/openjdk/bin ]] && export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# Node via fnm: a per-shell node that follows .node-version/.nvmrc on cd (FNM_DIR is in zshenv).
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"

# gpg pinentry can find the terminal (fixes signing timeouts)
if tty -s; then export GPG_TTY=$(tty); fi
