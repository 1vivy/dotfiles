#!/bin/sh
# Obsidian MCP over the University hub vault: the plain-file LiveSync mirror on atlas-agent that
# Haerin and DeepTutor read (borrrk-infra obsidian-sync). atlas-agent runs MCPVault on it directly;
# every other host runs this script there over SSH, so all hosts see the same current notes.
# omp/mcp-all.json exposes only read tools: writes into the hub go through Haerin's vault_write.py
# or through an Obsidian client, never straight onto the NFS mirror.
set -eu
vault="$HOME/University/vault"
if [ -d "$vault" ]; then
  PATH="$HOME/.local/share/fnm/aliases/default/bin:$PATH"
  exec npx -y @bitbonsai/mcpvault@0.17.1 "$vault"
fi
if [ "${1:-}" = --local ]; then
  echo "obsidian-mcp: $vault is not available on $(hostname)" >&2
  exit 1
fi
exec ssh -T -o BatchMode=yes atlas-agent '$HOME/.local/bin/obsidian-mcp --local'
