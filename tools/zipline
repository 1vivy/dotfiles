#!/usr/bin/env bash
# zipline — upload files to a Zipline instance, put the resulting URL(s) on
# the clipboard, and notify. Screenshots are handled by XerahS.
#
# Usage:
#   zipline FILE [FILE...]  upload the given files in one request
#   zipline -n NAME FILE    upload under an exact name (extension added by server)
#   zipline -o FILE...      keep each file's own name as the URL name
#   zipline -e 1d FILE      upload with a server-side expiry (Zipline deletes-at)
#
# Config: ~/.config/zipline/config  (mode 600)
#   ZIPLINE_URL=https://share.example/api/upload
#   ZIPLINE_TOKEN=...
#   ZIPLINE_EXPIRE=            # optional default, e.g. 1d / 6h / 30m
# Env vars of the same names override the config file.

set -euo pipefail

readonly PROG=${0##*/}
CONFIG=${ZIPLINE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/zipline/config}

die() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	notify "Upload failed" "$*" dialog-error
	exit 1
}

notify() {
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -a Zipline -i "${3:-document-send}" -- "$1" "${2:-}" || true
}

clip() {
	if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null 2>&1; then
		printf '%s' "$1" | wl-copy
	elif command -v xclip >/dev/null 2>&1; then
		printf '%s' "$1" | xclip -selection clipboard
	else
		return 1
	fi
}

# Env wins over the config file: stash, source, restore.
env_url=${ZIPLINE_URL:-} env_token=${ZIPLINE_TOKEN:-} env_expire=${ZIPLINE_EXPIRE:-}
# shellcheck source=/dev/null
[[ -r $CONFIG ]] && source "$CONFIG"
[[ -n $env_url ]] && ZIPLINE_URL=$env_url
[[ -n $env_token ]] && ZIPLINE_TOKEN=$env_token
[[ -n $env_expire ]] && ZIPLINE_EXPIRE=$env_expire
: "${ZIPLINE_URL:?not set (add it to $CONFIG)}"
: "${ZIPLINE_TOKEN:?not set (add it to $CONFIG)}"
expire=${ZIPLINE_EXPIRE:-}

files=()
name=
keep_name=

while (($#)); do
	case $1 in
	-e | --expire)
		[[ $# -ge 2 ]] || die "$1 needs a value"
		expire=$2
		shift
		;;
	-n | --name)
		[[ $# -ge 2 ]] || die "$1 needs a value"
		name=$2
		shift
		;;
	-o | --original-name) keep_name=1 ;;
	-h | --help)
		sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	--)
		shift
		files+=("$@")
		break
		;;
	-*) die "unknown option: $1" ;;
	*) files+=("$1") ;;
	esac
	shift
done

((${#files[@]})) || die "no files given (screenshots moved to XerahS)"
for f in "${files[@]}"; do
	[[ -f $f ]] || die "not a file: $f"
	[[ -r $f ]] || die "not readable: $f"
done

# Zipline derives the stored extension from the source name: the last suffix,
# except for the compound archive forms it special-cases (tar.gz/tar.xz/tar.bz2).
server_ext() {
	local base=${1##*/}
	base=${base#.}
	case $base in
	*.tar.gz | *.tar.xz | *.tar.bz2) printf '%s' "tar.${base##*.}" ;;
	*.*) printf '%s' "${base##*.}" ;;
	esac
}

# Strip the extension Zipline is going to append, so "-n a.bak" != "a.bak.bak"
# and "-o foo.tar.gz" != "foo.tar.tar.gz" (which Zipline's own format=name does).
strip_ext() {
	local n=$1 ext=$2
	[[ -n $ext && $n == *".$ext" ]] && n=${n%".$ext"}
	printf '%s' "$n"
}

upload() { # upload FILENAME_HEADER FILE... -> JSON on stdout
	local hdr=$1 args f
	shift
	args=(-s --fail-with-body -m 300 -H "authorization: $ZIPLINE_TOKEN")
	[[ -n $expire ]] && args+=(-H "x-zipline-deletes-at: $expire")
	[[ -n $hdr ]] && args+=(-H "x-zipline-filename: $hdr")
	for f in "$@"; do args+=(-F "file=@$f"); done
	local out
	out=$(curl "${args[@]}" "$ZIPLINE_URL") ||
		die "$(jq -r '.error // .' <<<"${out:-server unreachable}" 2>/dev/null ||
			printf '%s' "$out")"
	printf '%s' "$out"
}

urls=
if [[ -n $name ]]; then
	((${#files[@]} == 1)) || die "--name takes exactly one file"
	response=$(upload "$(strip_ext "$name" "$(server_ext "${files[0]}")")" "${files[0]}")
elif [[ -n $keep_name ]]; then
	# One request per file: the filename header is per-request, not per-part.
	for f in "${files[@]}"; do
		base=${f##*/}
		response=$(upload "$(strip_ext "$base" "$(server_ext "$f")")" "$f")
		urls+=$(jq -er '.files[0].url' <<<"$response" ||
			die "unexpected response: $response")$'\n'
	done
	urls=${urls%$'\n'}
else
	response=$(upload "" "${files[@]}")
fi

if [[ -z $urls ]]; then
	urls=$(jq -er '.files | map(.url) | join("\n")' <<<"$response") ||
		die "unexpected response: $response"
fi

clip "$urls" || printf '%s: no clipboard tool (wl-copy/xclip)\n' "$PROG" >&2
printf '%s\n' "$urls"

count=$(wc -l <<<"$urls")
if ((count == 1)); then
	notify "Uploaded ${files[0]##*/}" "$urls"
else
	notify "Uploaded $count files" "$urls"
fi
